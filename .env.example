# =============================================================================
# GymBot Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram Bot Configuration (Required)
# -----------------------------------------------------------------------------
# Get your token from @BotFather on Telegram
TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (get it from @userinfobot)
ADMIN_ID=0

# Group ID for notifications (optional, starts with -100)
GROUP_ID=-1001234567890

# -----------------------------------------------------------------------------
# MongoDB Configuration (Required)
# -----------------------------------------------------------------------------
# For local development with docker-compose:
MONGO_URI=mongodb://admin:changeme@localhost:27017/gym?authSource=admin

# For MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gym?appName=Cluster0

# Root password for MongoDB container (only used for docker-compose)
MONGO_ROOT_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Dashboard Configuration (Required)
# -----------------------------------------------------------------------------
# Secret key for session signing (generate with: openssl rand -hex 32)
DASHBOARD_SECRET=your_random_secret_key_here_min_32_chars

# Port for web dashboard
DASHBOARD_PORT=8080

# Dashboard host (use 0.0.0.0 for Docker, 127.0.0.1 for local)
DASHBOARD_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable JSON format for logs (useful for production)
JSON_LOGS=false

# -----------------------------------------------------------------------------
# Redis Configuration (Optional)
# -----------------------------------------------------------------------------
# Uncomment to enable Redis for distributed rate limiting
# REDIS_URL=redis://localhost:6379/0

# For Redis with Docker:
# REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Sentry Configuration (Optional)
# -----------------------------------------------------------------------------
# For error tracking in production
# SENTRY_DSN=https://public@sentry.example.com/1

# -----------------------------------------------------------------------------
# File Paths (Optional - defaults are usually fine)
# -----------------------------------------------------------------------------
# Directory for log files
# LOGS_DIR=logs

# Directory for reports and exports
# REPORTS_DIR=reports

# Directory for data files
# DATA_DIR=data

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable automatic daily notifications
ENABLE_NOTIFICATIONS=true

# Time for daily notifications (24-hour format)
NOTIFICATION_TIME=10:00